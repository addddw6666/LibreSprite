@@ -0,0 +1,191 @@
+// LibreSprite | Panel de imagen de referencia
+//
+// This file is released under the terms of the MIT license.
+// Read LICENSE.txt for more information.
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "app/ui/reference_panel.h"
+
+#include "app/file_selector.h"
+#include "gfx/color.h"
+#include "she/surface.h"
+#include "she/system.h"
+#include "ui/box.h"
+#include "ui/button.h"
+#include "ui/graphics.h"
+#include "ui/paint_event.h"
+#include "ui/size_hint_event.h"
+#include "ui/theme.h"
+#include "ui/view.h"
+#include "ui/widget.h"
+
+#include <algorithm>
+
+namespace app {
+
+using namespace ui;
+
+namespace {
+  const int kZoomSteps[] = { 10, 25, 50, 75, 100, 150, 200, 300, 400, 800 };
+  const int kZoomStepCount = sizeof(kZoomSteps) / sizeof(kZoomSteps[0]);
+  const int kMaxPixels = 16 * 1024 * 1024; // límite de memoria de la copia escalada
+
+  // Copia con escala "vecino más cercano" (ideal para pixel art).
+  she::Surface* scaleNearest(she::Surface* src, int percent)
+  {
+    int w = std::max(1, src->width() * percent / 100);
+    int h = std::max(1, src->height() * percent / 100);
+    if (w * h > kMaxPixels)
+      return nullptr;
+
+    she::Surface* dst = she::instance()->createRgbaSurface(w, h);
+    if (!dst)
+      return nullptr;
+
+    src->lock();
+    dst->lock();
+    for (int y=0; y<h; ++y) {
+      const int sy = std::min(src->height()-1, y * 100 / percent);
+      for (int x=0; x<w; ++x) {
+        const int sx = std::min(src->width()-1, x * 100 / percent);
+        dst->putPixel(src->getPixel(sx, sy), x, y);
+      }
+    }
+    dst->unlock();
+    src->unlock();
+    return dst;
+  }
+}
+
+class ReferencePanel::ImageWidget : public ui::Widget {
+public:
+  ImageWidget() : m_surface(nullptr) { }
+  ~ImageWidget() { setSurface(nullptr); }
+
+  // Toma posesión de la superficie.
+  void setSurface(she::Surface* surface) {
+    if (m_surface)
+      m_surface->dispose();
+    m_surface = surface;
+  }
+
+protected:
+  void onSizeHint(SizeHintEvent& ev) override {
+    if (m_surface)
+      ev.setSizeHint(gfx::Size(m_surface->width(), m_surface->height()));
+    else
+      ev.setSizeHint(gfx::Size(1, 1));
+  }
+
+  void onPaint(PaintEvent& ev) override {
+    Graphics* g = ev.graphics();
+    g->fillRect(gfx::rgba(48, 48, 48), clientBounds());
+    if (m_surface)
+      g->drawRgbaSurface(m_surface, 0, 0);
+  }
+
+private:
+  she::Surface* m_surface;
+};
+
+ReferencePanel::ReferencePanel()
+  : m_view(new View())
+  , m_image(new ImageWidget())
+  , m_source(nullptr)
+  , m_percent(100)
+{
+  const int scale = guiscale();
+  auto makeButton = [scale](const char* text) {
+    auto* button = new Button(text);
+    button->setMinSize(gfx::Size(18 * scale, 12 * scale));
+    return button;
+  };
+
+  auto* bar = new HBox();
+  auto* open = makeButton("Abrir");
+  auto* zoomOut = makeButton("-");
+  auto* zoomIn = makeButton("+");
+  auto* fit = makeButton("Ajustar");
+  open->Click.connect([this](Event&) { openImage(); });
+  zoomOut->Click.connect([this](Event&) { zoomStep(-1); });
+  zoomIn->Click.connect([this](Event&) { zoomStep(+1); });
+  fit->Click.connect([this](Event&) { fitToWidth(); });
+  bar->addChild(open);
+  bar->addChild(zoomOut);
+  bar->addChild(zoomIn);
+  bar->addChild(fit);
+
+  m_view->attachToView(m_image);
+  m_view->setExpansive(true);
+
+  addChild(bar);
+  addChild(m_view);
+  setExpansive(true);
+}
+
+ReferencePanel::~ReferencePanel()
+{
+  if (m_source)
+    m_source->dispose();
+}
+
+void ReferencePanel::openImage()
+{
+  std::string filename = show_file_selector(
+    "Imagen de referencia", "", "png,jpg,jpeg,gif,bmp", FileSelectorType::Open);
+  if (filename.empty())
+    return;
+
+  she::Surface* loaded = she::instance()->loadRgbaSurface(filename.c_str());
+  if (!loaded)
+    return;
+
+  if (m_source)
+    m_source->dispose();
+  m_source = loaded;
+  fitToWidth();
+}
+
+void ReferencePanel::zoomStep(int direction)
+{
+  if (!m_source)
+    return;
+
+  int index = 0;
+  for (int i=0; i<kZoomStepCount; ++i)
+    if (kZoomSteps[i] <= m_percent)
+      index = i;
+  index = std::max(0, std::min(kZoomStepCount-1, index + direction));
+  applyZoom(kZoomSteps[index]);
+}
+
+void ReferencePanel::fitToWidth()
+{
+  if (!m_source)
+    return;
+
+  const int available = m_view->visibleSize().w;
+  int percent = (available > 0 ? available * 100 / m_source->width() : 100);
+  applyZoom(std::max(5, std::min(800, percent)));
+}
+
+void ReferencePanel::applyZoom(int percent)
+{
+  if (!m_source)
+    return;
+
+  she::Surface* scaled = scaleNearest(m_source, percent);
+  if (!scaled)
+    return; // demasiado grande: se conserva el zoom anterior
+
+  m_percent = percent;
+  m_image->setSurface(scaled);
+  m_view->updateView();
+  m_view->layout();
+  m_image->invalidate();
+}
+
+} // namespace app
