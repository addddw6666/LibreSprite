+  class MorePanel : public Window {
+  public:
+    MorePanel()
+      : Window(WithTitleBar, "Más funciones")
+      , m_pending(nullptr)
+    {
+      const int scale = guiscale();
+      const int columns = 3;
+
+      // Contenido desplazable con todas las categorías.
+      auto* content = new VBox();
+      for (const Category& category : categories()) {
+        content->addChild(new Separator(category.title, HORIZONTAL));
+
+        auto* grid = new Grid(columns, true);
+        grid->setExpansive(true);
+        int index = 0;
+        for (const Item& item : category.items) {
+          auto* button = new Button(item.label);
+          button->setMinSize(gfx::Size(36 * scale, 14 * scale));
+          button->Click.connect([this, &item](Event&) {
+            // Se ejecuta cuando el panel ya se cerró (ver show_more_panel)
+            // para que los diálogos de cada comando abran encima del editor.
+            m_pending = &item;
+            closeWindow(this);
+          });
+          grid->addChildInCell(button, 1, 1, HORIZONTAL | VERTICAL);
+          ++index;
+        }
+        content->addChild(grid);
+      }
+
+      auto* view = new View();
+      view->attachToView(content);
+      view->setExpansive(true);
+      // Ocupa la mayor parte de la pantalla (en un teléfono, casi toda).
+      view->setSizeHint(gfx::Size(display_w() * 9 / 10, display_h() * 8 / 10));
+
+      auto* closeButton = new Button("Cerrar");
+      closeButton->setMinSize(gfx::Size(36 * scale, 14 * scale));
+      closeButton->Click.connect([this](Event&) { closeWindow(this); });
+
+      auto* root = new VBox();
+      root->addChild(view);
+      root->addChild(closeButton);
+      addChild(root);
+    }
+
+    const Item* pending() const { return m_pending; }
+
+  private:
+    const Item* m_pending;
+  };
+
+} // anonymous namespace
+
+void show_more_panel()
+{
+  const Item* chosen = nullptr;
+  {
+    MorePanel panel;
+    panel.openWindowInForeground();
+    chosen = panel.pending();
+  }
+
+  if (!chosen)
+    return;
+
+  Command* command = CommandsModule::instance()->getCommandByName(chosen->command);
+  if (!command)
+    return;
+
+  Params params;
+  for (const auto& p : chosen->params)
+    params.set(p.first, p.second);
+
+  UIContext::instance()->executeCommand(command, params);
+}
+
+} // namespace app
