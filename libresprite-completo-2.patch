+
+  std::string text;
+  ui::Widget* widget;
+};
+
+PanelDock::PanelDock()
+  : ui::Box(ui::VERTICAL)
+  , m_tabs(new Tabs(this))
+{
+  m_tabs->setDockedStyle();
+  addChild(m_tabs);
+}
+
+PanelDock::~PanelDock()
+{
+  // m_tabs y los paneles son hijos de este widget: ui::Widget los destruye.
+}
+
+void PanelDock::addPanel(const std::string& title, ui::Widget* panel)
+{
+  const bool first = m_panels.empty();
+
+  std::unique_ptr<PanelTab> tab(new PanelTab(title, panel));
+  addChild(panel);
+  panel->setVisible(first);
+
+  m_tabs->addTab(tab.get(), false);
+  if (first)
+    m_tabs->selectTab(tab.get());
+
+  m_panels.push_back(std::move(tab));
+}
+
+void PanelDock::selectPanel(int index)
+{
+  if (index < 0 || index >= int(m_panels.size()))
+    return;
+  m_tabs->selectTab(m_panels[index].get());
+}
+
+void PanelDock::onSelectTab(Tabs*, TabView* tabView)
+{
+  showPanelFor(tabView);
+}
+
+void PanelDock::showPanelFor(TabView* tabView)
+{
+  for (auto& tab : m_panels)
+    tab->widget->setVisible(tab.get() == tabView);
+
+  if (parent())
+    layout();
+}
+
+} // namespace app
