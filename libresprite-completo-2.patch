+namespace app {
+
+  // Contenedor con una barra de pestañas arriba y un solo panel visible
+  // abajo. Las pestañas se pueden reordenar arrastrándolas (reutiliza el
+  // widget Tabs de las pestañas de documentos).
+  class PanelDock : public ui::Box
+                  , public TabsDelegate {
+  public:
+    PanelDock();
+    ~PanelDock();
+
+    // Agrega "panel" como una pestaña nueva. El dock pasa a ser su
+    // padre (y por lo tanto quien lo destruye).
+    void addPanel(const std::string& title, ui::Widget* panel);
+
+    // Muestra el panel de la pestaña "index" (en orden de creación).
+    void selectPanel(int index);
+
+  private:
+    class PanelTab;
+
+    void showPanelFor(TabView* tabView);
+
+    // TabsDelegate
+    bool isTabModified(Tabs*, TabView*) override { return false; }
+    bool canCloneTab(Tabs*, TabView*) override { return false; }
+    void onSelectTab(Tabs*, TabView* tabView) override;
+    void onCloseTab(Tabs*, TabView*) override { }
+    void onCloneTab(Tabs*, TabView*, int) override { }
+    void onContextMenuTab(Tabs*, TabView*) override { }
+    void onMouseOverTab(Tabs*, TabView*) override { }
+    DropViewPreviewResult onFloatingTab(Tabs*, TabView*, const gfx::Point&) override {
+      // La pestaña no sale de la barra: solo se reordena dentro de ella.
+      return DropViewPreviewResult::DROP_IN_TABS;
+    }
+    void onDockingTab(Tabs*, TabView*) override { }
+    DropTabResult onDropTab(Tabs*, TabView*, const gfx::Point&, bool) override {
+      return DropTabResult::NOT_HANDLED;
+    }
+
+    Tabs* m_tabs;
+    std::vector<std::unique_ptr<PanelTab>> m_panels;
+  };
+
+}
